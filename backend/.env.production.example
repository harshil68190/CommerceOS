# .env.production.example
#
# Responsibility
# --------------
# A documented, NON-SECRET template for the environment variables the
# backend needs in PRODUCTION. This is NOT a file to copy into the image
# or commit; it documents what the Render dashboard (or your PaaS) must
# inject as real environment variables / secrets.
#
# Copy the values into your Render service's "Environment" settings, or
# set them via the Render CLI. NEVER commit real secrets to the repo.
#
# For Render, most connection strings are auto-injected when you use the
# managed Postgres / Redis add-ons (the `fromDatabase` / `fromRedis`
# directives in render.yaml). This file simply documents every variable
# and what it should be.

# --- Application ----------------------------------------------------------
APP_NAME=CommerceOS
ENVIRONMENT=production
DEBUG=false

# --- Logging ---------------------------------------------------------------
# Explicit production log level. Overrides the DEBUG-derived default.
LOG_LEVEL=INFO

# --- Server -----------------------------------------------------------------
# Number of uvicorn worker processes. Each worker gets its own DB pool.
# Keep in mind total DB connections = WEB_CONCURRENCY * DB_POOL_SIZE.
WEB_CONCURRENCY=2

# --- Database ---------------------------------------------------------------
# MUST be set to Render's "Internal Database URL" (or your managed PG URL).
# The app normalizes `postgres://` / `postgresql://` to the psycopg v3
# driver automatically, so this is the raw URL Render provides.
# Example:
#   postgresql://commerceos:<password>@<host>:5432/commerceos
DATABASE_URL=postgresql+psycopg://REPLACE_ME

# Connection pool sizing. Keep the pool modest in production; the managed
# PG instance has a connection limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO=false

# --- Redis -------------------------------------------------------------------
# MUST be set to Render's Redis connection string (internal or external).
# The app expects a redis:// scheme; Render's managed Redis may supply a
# rediss:// (TLS) URL, which the redis client supports natively.
# Example:
#   rediss://default:<password>@<host>:6379
REDIS_URL=redis://REPLACE_ME

# --- Migrations ---------------------------------------------------------------
# false on the web service (migrations run as a separate one-off job).
# Set to true only for local/single-node workflows.
RUN_MIGRATIONS=false

# --- Security ---------------------------------------------------------------
# REQUIRED. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# This MUST be a strong, unique secret for production. Never reuse a dev
# key. Store it as a Render secret (not a plain env var).
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins. For production this is
# the deployed frontend origin (e.g. https://app.onrender.com or your
# custom domain). Do NOT use "*" with allow_credentials=True.
CORS_ORIGINS=https://REPLACE_WITH_FRONTEND_URL
