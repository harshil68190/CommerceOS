# .env.example
#
# Responsibility: a documented, non-secret template for the environment
# variables the backend needs. Copy this to `.env` and fill in real
# values:
#
#   cp backend/.env.example backend/.env
#
# NEVER commit `.env` — it is git-ignored. This example file is safe to
# commit because it contains only placeholders, never real secrets.
#
# Two runtime modes matter here:
#   1. Running the app natively on the host (uvicorn directly):
#      DATABASE_URL / REDIS_URL point at your local Postgres/Redis on
#      localhost with the ports you actually use.
#   2. Running under docker-compose: the compose file OVERRIDES
#      DATABASE_URL / REDIS_URL to use the `postgres`/`redis` service
#      hostnames, so the localhost values here don't matter for that
#      path. JWT_SECRET_KEY is always read from .env.

# --- Application --------------------------------------------------------
APP_NAME=CommerceOS
ENVIRONMENT=development
DEBUG=true

# --- Database -----------------------------------------------------------
# SQLAlchemy connection URL. For a native run, use your local Postgres.
# For docker-compose this is overridden automatically (see compose file).
# `%` must be URL-encoded (e.g. a literal `@` in a password becomes `%40`).
DATABASE_URL=postgresql+psycopg://commerceos:commerceos@localhost:5432/commerceos

# --- Redis --------------------------------------------------------------
# For a native run, use your local Redis. For docker-compose this is
# overridden automatically (see compose file).
REDIS_URL=redis://localhost:6379/0

# --- Security -----------------------------------------------------------
# REQUIRED. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Do NOT commit a real value here; this placeholder must be replaced.
JWT_SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-chars
